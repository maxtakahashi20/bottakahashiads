{
  "name": "takahashi-ads-site",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prisma:generate": "npm run prisma:generate --prefix ..",
    "postinstall": "npm run prisma:generate --prefix ..",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start:api": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
