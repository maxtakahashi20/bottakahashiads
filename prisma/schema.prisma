generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GuildSettings {
  id                String        @id @default(cuid())
  tenantId          String        @default("platform")
  guildId           String
  adsEnabled        Boolean       @default(true)
  adsChannelId      String?
  partnerGuildName  String?
  delayMinutes      Int           @default(50)
  customMessage     String?
  nextSendAt        DateTime?
  userCooldownSec   Int           @default(900)
  guildCooldownSec  Int           @default(900)
  allowedCategories AdCategory[]  @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partnershipsAsA   Partnership[] @relation("GuildA")
  partnershipsAsB   Partnership[] @relation("GuildB")

  @@unique([tenantId, guildId])
  @@index([tenantId])
}

model Partnership {
  id        String        @id @default(cuid())
  tenantId  String        @default("platform")
  guildAId  String
  guildBId  String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  guildA    GuildSettings @relation("GuildA", fields: [tenantId, guildAId], references: [tenantId, guildId], onDelete: Cascade, onUpdate: NoAction)
  guildB    GuildSettings @relation("GuildB", fields: [tenantId, guildBId], references: [tenantId, guildId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, guildAId, guildBId], map: "Partnership_unique_pair")
  @@index([active])
  @@index([guildAId])
  @@index([guildBId])
}

model Advertisement {
  id          String       @id @default(cuid())
  tenantId    String       @default("platform")
  guildId     String
  userId      String
  title       String
  description String
  bannerUrl   String?
  inviteUrl   String
  category    AdCategory
  sanitized   Boolean      @default(true)
  sentCount   Int          @default(0)
  failedCount Int          @default(0)
  createdAt   DateTime     @default(now())
  deliveries  AdDelivery[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, guildId, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([userId])
}

model AdDelivery {
  id              String        @id @default(cuid())
  advertisementId String
  targetGuildId   String
  targetChannelId String
  status          String
  error           String?
  createdAt       DateTime      @default(now())
  ad              Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([advertisementId])
  @@index([targetGuildId, createdAt(sort: Desc)])
  @@index([status])
}

model Cooldown {
  id        String   @id @default(cuid())
  tenantId  String   @default("platform")
  scope     String
  key       String
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key], map: "Cooldown_unique_tenant_scope_key")
  @@index([expiresAt])
  @@index([scope, key])
}

model Analytics {
  id              String   @id @default(cuid())
  tenantId        String   @unique @default("platform")
  totalAds        Int      @default(0)
  totalDeliveries Int      @default(0)
  totalFailures   Int      @default(0)
  connectedGuilds Int      @default(0)
  networkEnabled  Boolean  @default(true)
  updatedAt       DateTime @default(now()) @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Blacklist {
  id        String   @id @default(cuid())
  tenantId  String   @default("platform")
  type      String
  targetId  String
  reason    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, targetId], map: "Blacklist_unique_tenant_type_target")
  @@index([type])
  @@index([targetId])
}

model Premium {
  id           String      @id @default(cuid())
  guildId      String      @unique
  plan         PremiumPlan @default(NONE)
  priority     Int         @default(0)
  highlightAds Boolean     @default(false)
  maxAdsPerDay Int         @default(1)
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([expiresAt])
  @@index([plan])
}

model LogEvent {
  id        String   @id @default(cuid())
  type      String
  guildId   String?
  userId    String?
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([userId])
}

model SystemConfig {
  id               String    @id @default("global")
  botRunning       Boolean   @default(true)
  globalMessage    String?
  globalBannerUrl  String?
  globalInviteUrl  String?
  messagesPerCycle Int       @default(1)
  delayMsgMinSec   Float     @default(2)
  delayMsgMaxSec   Float     @default(5)
  delayGuildMinSec Float     @default(15)
  delayGuildMaxSec Float     @default(35)
  minCycleMinutes  Float     @default(50)
  totalCycles      Int       @default(0)
  scheduledAt      DateTime?
  lastSendAt       DateTime?
  updatedAt        DateTime  @updatedAt
}

model DivulgationRun {
  id              String    @id @default(cuid())
  tenantId        String    @default("platform")
  number          Int       @default(0)
  status          String    @default("running")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  messagesSent    Int       @default(0)
  cyclesDone      Int       @default(0)
  errorsCount     Int       @default(0)
  advertisementId String?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}

model UserToken {
  id             String    @id @default(cuid())
  tenantId       String    @default("platform")
  slot           Int
  ownerId        String
  discordUserId  String
  username       String
  tokenEnc       String
  active         Boolean   @default(true)
  lastError      String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slot])
  @@index([tenantId, active])
  @@index([active])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// SaaS — Licenças, tenants e assinaturas
// ---------------------------------------------------------------------------

model Tenant {
  id            String         @id @default(cuid())
  ownerUserId   String         @unique
  displayName   String?
  status        TenantStatus   @default(ACTIVE)
  isPlatform    Boolean        @default(false)
  notifyExpiry  Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  licenses      License[]
  subscriptions Subscription[]
  settings      TenantSettings?
  guildSettings GuildSettings[]
  userTokens    UserToken[]
  advertisements Advertisement[]
  analytics     Analytics?
  blacklists    Blacklist[]
  cooldowns     Cooldown[]
  divulgationRuns DivulgationRun[]
  auditLogs     AuditLog[]
  branding      TenantBranding?
  embedTemplate TenantEmbedTemplate?
  webSessions   WebSession[]
}

model License {
  id                String          @id @default(cuid())
  code              String          @unique
  duration          LicenseDuration
  status            LicenseStatus   @default(PENDING)
  createdByUserId   String
  activatedByUserId String?
  tenantId          String?
  activatedAt       DateTime?
  revokedAt         DateTime?
  revokedByUserId   String?
  note              String?
  createdAt         DateTime        @default(now())
  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  subscriptions     Subscription[]

  @@index([status])
  @@index([tenantId])
  @@index([createdByUserId])
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String
  licenseId String
  startsAt  DateTime
  endsAt    DateTime
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  license   License            @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([endsAt])
  @@index([licenseId])
}

model TenantSettings {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  botRunning       Boolean  @default(true)
  globalMessage    String?
  globalBannerUrl  String?
  globalInviteUrl  String?
  messagesPerCycle Int      @default(1)
  delayMsgMinSec   Float    @default(2)
  delayMsgMaxSec   Float    @default(5)
  delayGuildMinSec Float    @default(15)
  delayGuildMaxSec Float    @default(35)
  minCycleMinutes  Float    @default(50)
  totalCycles      Int      @default(0)
  scheduledAt      DateTime?
  lastSendAt       DateTime?
  networkEnabled   Boolean  @default(true)
  configVersion    Int      @default(1)
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Branding do bot visível no painel web (nome, avatar, status).
model TenantBranding {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  botDisplayName  String?
  botAvatarUrl    String?
  botStatusText   String?
  botStatusType   String?  @default("online")
  botDescription  String?
  primaryColor    String?  @default("#5865F2")
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Template de embed editável no painel web.
model TenantEmbedTemplate {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  title         String?
  description   String?
  color         Int?
  bannerUrl     String?
  thumbnailUrl  String?
  footerText    String?
  footerIconUrl String?
  buttonLabel   String?
  buttonUrl     String?
  useEmbedMode  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Sessão web OAuth (opcional; JWT é primário).
model WebSession {
  id           String   @id @default(cuid())
  discordId    String
  tenantId     String?
  refreshHash  String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([discordId])
  @@index([tenantId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String?
  action    String
  target    String?
  message   String?
  meta      Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([action, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId])
}

model Cart {
  id         Int        @id @default(autoincrement())
  userId     String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  couponCode String?
  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem   CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  Cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Coupon {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  discount  Float
  type      CouponType @default(PERCENTAGE)
  maxUses   Int?
  usedCount Int        @default(0)
  expiresAt DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
}

model Log {
  id        Int      @id @default(autoincrement())
  action    String
  userId    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         String
  total          Float
  status         OrderStatus @default(PENDING)
  couponCode     String?
  discount       Float       @default(0)
  ticketId       String?
  paymentMethod  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  proofMessageId String?
  proofUrl       String?
  voiceChannelId String?
  User           User        @relation(fields: [userId], references: [id])
  OrderItem      OrderItem[]
  Payment        Payment?

  @@index([status])
  @@index([ticketId])
  @@index([userId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  price       Float
  quantity    Int
  Order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product     Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int           @unique
  method     String
  amount     Float
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime
  externalId String?
  provider   String?
  Order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String
  delivery    String      @default("1-3 dias")
  stock       Int?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  channelId   String?
  messageId   String?
  CartItem    CartItem[]
  OrderItem   OrderItem[]

  @@index([active])
  @@index([category])
}

model PurchaseHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  orderId   Int
  total     Float
  products  String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Ticket {
  id        Int          @id @default(autoincrement())
  channelId String       @unique
  userId    String
  type      TicketType   @default(SUPPORT)
  status    TicketStatus @default(OPEN)
  subject   String?
  createdAt DateTime     @default(now())
  closedAt  DateTime?
  User      User         @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model User {
  id              String            @id
  username        String
  totalSpent      Float             @default(0)
  ordersCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Cart            Cart?
  Order           Order[]
  PurchaseHistory PurchaseHistory[]
  Ticket          Ticket[]
}

enum AdCategory {
  FIVEM
  ROLEPLAY
  GAMING
  STORE
  COMMUNITY
  OTHER
}

enum PremiumPlan {
  NONE
  STARTER
  PRO
  ENTERPRISE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum TicketType {
  SUPPORT
  PURCHASE
  BUDGET
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum LicenseStatus {
  PENDING
  ACTIVATED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LicenseDuration {
  MONTH_1
  MONTH_3
  YEAR_1
}
