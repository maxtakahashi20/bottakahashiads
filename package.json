{
  "name": "takahashi-network",
  "version": "1.0.0",
  "description": "Takahashi Network — bot profissional de parcerias e divulgação automática entre servidores Discord.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "prisma generate",
    "dev": "nodemon src/index.js",
